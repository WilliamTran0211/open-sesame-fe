# API the app talks to. Keep it on https: the session cookie is Secure and SameSite=Lax,
# so the app and the API must share the scheme to count as the same site.
NUXT_PUBLIC_API_BASE_URL = "https://localhost:8000/api/v1"

# Local https for `nuxt dev` (e.g. certificates from `mkcert localhost`).
# Leave unset to serve the dev app over plain http.
DEV_SSL_KEY = "../be/localhost-key.pem"
DEV_SSL_CERT = "../be/localhost.pem"
